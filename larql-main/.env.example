# LARQL Configuration
# This file shows available environment variables for LARQL configuration
# Copy this file to .env and set your values

# Vindex Configuration
# Vindex path for loading vector index
LARQL_VINDEX__PATH=data/bitnet_b1_58-large/vindex

# Model Configuration
# Model path (HuggingFace model ID or local path)
LARQL_MODEL__PATH=google/gemma-3-4b-it

# HuggingFace Configuration
# HuggingFace API token (required for private models)
LARQL_HUGGINGFACE__TOKEN=
# HuggingFace cache directory (relative to home directory)
LARQL_HUGGINGFACE__CACHE_DIR=.cache/huggingface/hub

# Path Configuration
# Home directory (auto-detected if not set)
LARQL_PATHS__HOME_DIR=
